t <- 1
time <- 1
while (t >= 1){
unchanged <- TRUE
P <- expm(Q*t)
P_next <- expm(Q*2*t)
for (i in 1:4){
for (j in 1:4){
if (abs(P[i,j] - P_next[i,j]) > 0.0000001 & i != j){
unchanged <- FALSE
}
}
}
print(abs(P[i,j] - P_next[i,j]))
if (unchanged) {
time <- t
t <- 0
} else {
t <- t+1
}
}
